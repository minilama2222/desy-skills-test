{
  "name": "desy-skills-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Harness de tests de capacidad para los skills DESY",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "precommit": "npm run typecheck && npm run verificar-tests && npm run verificar-tracker && npm test",
    "verificar-tests": "tsx scripts/verificar-tests.ts",
    "verificar-tracker": "tsx scripts/verificar-tracker.ts",
    "setup:hooks": "git config core.hooksPath scripts/git-hooks",
    "run": "tsx src/cli.ts run",
    "grade": "tsx src/cli.ts grade",
    "load": "tsx src/cli.ts load",
    "capturar-gold": "tsx src/cli.ts capturar-gold",
    "capturar-mockup": "tsx scripts/capturar-mockup.ts",
    "verificar-captura-gold": "tsx scripts/verificar-captura-gold.ts",
    "report": "tsx src/cli.ts report",
    "bump-pin": "tsx src/cli.ts bump-pin"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

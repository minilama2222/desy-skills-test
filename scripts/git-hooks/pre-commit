#!/bin/sh
# Guardarraíl pre-commit: typecheck + tests + guardarraíles (tests, tracker, casos
# y fixtures de mockup). Se activa con: git config core.hooksPath scripts/git-hooks
set -e
npm run typecheck
npm run verificar-tests
npm run verificar-tracker
npm run verificar-casos
npm run verificar-mockup
npm test
